<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirect the www alias (including static files) to the canonical HTTPS host.
    RewriteCond %{HTTP_HOST} ^www\.engleza\.wiki(?::\d+)?$ [NC]
    RewriteRule ^ https://engleza.wiki%{REQUEST_URI} [R=301,L,NE]

    # Normalize application URLs before rewriting into the public directory.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} !-d
    RewriteRule ^(.+)/$ /$1 [R=301,L]

    # Direct traffic to the public directory
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>